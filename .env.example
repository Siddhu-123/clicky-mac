# Clicky for macOS - Environment Configuration & API Keys

# Active Provider: "gemini", "ollama", "openai", "claude", or "demo"
ACTIVE_PROVIDER=gemini

# ── 1. Google Gemini (Recommended Free Cloud Tier) ──
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 2. Ollama (100% Local, Offline & Free) ──
# Install: brew install ollama
# Pull vision model: ollama run llama3.2-vision
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# ── 3. Anthropic Claude (BYOK) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── 4. OpenAI (BYOK) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── 5. TTS Voice (Default: Free Microsoft Edge Neural TTS) ──
EDGE_VOICE=en-US-AvaNeural

# ── 6. Global Hotkey (Control + Option on macOS) ──
HOTKEY=ctrl+alt
