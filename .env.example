# Clicky for macOS (Apple MLX Edition)

# Apple Silicon MLX Model (Fastest: Qwen2-VL 2B 4-bit)
# Alternative: mlx-community/Qwen2.5-VL-3B-Instruct-4bit
MLX_MODEL=mlx-community/Qwen2-VL-2B-Instruct-4bit

# Push-to-Talk Hotkey (Control + Option on macOS)
HOTKEY=ctrl+alt

# Voice (Free Microsoft Edge Neural TTS)
EDGE_VOICE=en-US-AvaNeural
